rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Your Hisab data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Device tokens + timezone for background reminders (written by the app, read by /api/send-reminders via Admin SDK)
    match /pushTokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
